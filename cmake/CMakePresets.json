{
  "version": 6,
  "include": [
    ".env.json"
  ],
  "configurePresets": [
    {
      "name": "shared",
      "generator": "Ninja",
      "hidden": true,
      "inherits": [
        "env-vars"
      ],
      "cacheVariables": {
        "BUILD_IFCPYTHON": "ON",
        "BUILD_IFCGEOM": "ON",
        "COLLADA_SUPPORT": "OFF",
        "BUILD_EXAMPLES": "OFF",
        "BUILD_GEOMSERVER": "OFF",
        "GLTF_SUPPORT": "ON",
        "BUILD_CONVERT": "ON",
        "BUILD_IFCMAX": "OFF",
        "IFCXML_SUPPORT": "ON",
        "HDF5_SUPPORT": "ON",
        "SCHEMA_VERSIONS": "4x1"
      }
    },
    {
      "name": "win-shared",
      "inherits": [
        "shared"
      ],
      "hidden": true,
      "environment": {
        "CONDA_BUILD": "ON",
        "LIBRARY_PREFIX": "$env{PREFIX}/Library",
        "CONDA_PY": "311"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_IFCPYTHON": "ON",
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_INSTALL_PREFIX": "$env{LIBRARY_PREFIX}",
        "PYTHON_EXECUTABLE": "$env{PREFIX}/python.exe",
        "PYTHON_INCLUDE_DIR": "$env{PREFIX}/include",
        "PYTHON_LIBRARY": "$env{PREFIX}/libs/python$env{CONDA_PY}.lib",
        "CMAKE_FIND_ROOT_PATH": "$env{LIBRARY_PREFIX}",
        "CMAKE_PREFIX_PATH": "$env{LIBRARY_PREFIX};$env{LIBRARY_PREFIX}/include;$env{LIBRARY_PREFIX}/lib;$env{LIBRARY_PREFIX}/bin",
        "LIBXML2_LIBRARIES": "$env{LIBRARY_PREFIX}/lib/libxml2.lib",
        "OCC_INCLUDE_DIR": "$env{LIBRARY_PREFIX}/include/opencascade",
        "OCC_LIBRARY_DIR": "$env{LIBRARY_PREFIX}/lib",
        "JSON_INCLUDE_DIR": "$env{LIBRARY_PREFIX}/include",
        "GMP_INCLUDE_DIR": "$env{LIBRARY_PREFIX}/include",
        "GMP_LIBRARY_DIR": "$env{LIBRARY_PREFIX}/lib",
        "MPFR_LIBRARY_DIR": "$env{LIBRARY_PREFIX}/lib",
        "Boost_USE_STATIC_LIBS": "OFF",
        "HDF5_INCLUDE_DIR": "$env{LIBRARY_PREFIX}/include",
        "HDF5_LIBRARY_DIR": "$env{LIBRARY_PREFIX}/lib"
      }
    },
    {
      "name": "Win Conda debug (old)",
      "inherits": [
        "win-shared"
      ],
      "hidden": false,
      "environment": {
        "PREFIX": "$env{PREFIX_OLD}"
      }
    },
    {
      "name": "Win Conda debug (new)",
      "inherits": [
        "win-shared"
      ],
      "hidden": false,
      "environment": {
        "PREFIX": "$env{PREFIX_NEW}"
      }
    }
  ]
}